@page
@model MyPortfolioASP.Pages.LoginModel
@{
    ViewData["Title"] = "Admin Login";
}
<style>
   * {
        box-sizing: border-box;
    }
.login-page {
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: linear-gradient(135deg, #101a32, #243b68);
    font-family: Arial, sans-serif;
    overflow-x: hidden;
}

.login-card {
    width: 100%;
    max-width: 440px;
    margin: auto;
    padding: 40px;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
}

.login-logo {
    width: 58px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 22px;
    border-radius: 16px;
    background: #101a32;
    color: #ffffff;
    font-size: 22px;
    font-weight: bold;
}

.login-card h1 {
    margin: 0 0 10px;
    color: #101a32;
    font-size: 30px;
    text-align: center;
}

.login-description {
    margin-bottom: 28px;
    color: #687386;
    font-size: 15px;
    line-height: 1.6;
    text-align: center;
}

.login-label {
    display: block;
    margin-bottom: 9px;
    color: #263247;
    font-size: 14px;
    font-weight: 600;
}

.password-box {
    display: flex;
    width: 100%;
    gap: 8px;
    align-items: center;
}

.password-box input {
    min-width: 0;
    flex: 1;
    width: 100%;
    padding: 14px;
    border: 1px solid #d5dbe5;
    border-radius: 10px;
    font-size: 16px;
}

.show-password {
    padding: 12px 8px;
    border: none;
    background: transparent;
    color: #243b68;
    cursor: pointer;
    font-weight: 600;
}

.login-button {
    width: 100%;
    margin-top: 22px;
    padding: 15px;
    border: none;
    border-radius: 10px;
    background: #243b68;
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
}

.login-button:hover {
    background: #101a32;
}

.login-error {
    margin-top: 12px;
    color: #c62828;
    font-size: 14px;
}

.login-footer {
    margin-top: 25px;
    color: #7b8494;
    font-size: 12px;
    text-align: center;
}

@@media (max-width: 600px) {
    .login-page {
        padding: 14px;
        align-items: center;
    }

    .login-card {
        width: 100%;
        max-width: none;
        padding: 30px 22px;
        border-radius: 16px;
    }

    .login-card h1 {
        font-size: 27px;
    }
}
</style>

<div class="login-page">
    <main class="login-card">
        <div class="login-logo">MD</div>

    <h1>Welcome back</h1>
    <p class="login-description">
        Sign in to access your portfolio dashboard.
    </p>

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />

        <label class="login-label" for="Password">
            Admin password
        </label>

        <div class="password-box">
            <input asp-for="Password"
                   id="Password"
                   type="password"
                   placeholder="Enter your password"
                   autocomplete="current-password"
                   required />

            <button class="show-password"
                    type="button"
                    onclick="togglePassword()">
                Show
            </button>
        </div>

        <div asp-validation-summary="ModelOnly"
             class="login-error"></div>

        <button class="login-button" type="submit">
            Sign in to dashboard
        </button>
    </form>

    <div class="login-footer">
        Portfolio Management · Authorized Access
    </div>
</main>
</div>

<script>
    function togglePassword() {
        const password = document.getElementById("Password");
        const button = document.querySelector(".show-password");

        if (password.type === "password") {
            password.type = "text";
            button.textContent = "Hide";
        } else {
            password.type = "password";
            button.textContent = "Show";
        }
    }
</script>
