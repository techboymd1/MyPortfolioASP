@page
@model MyPortfolioASP.Pages.LoginModel
@{
    ViewData["Title"] = "Admin Login";
}
<style>
    .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: linear-gradient(135deg, #101a32, #243b68);
        font-family: Arial, sans-serif;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
        padding: 40px;
        background: white;
        border-radius: 20px;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
    }

    .login-logo {
        width: 54px;
        height: 54px;
        display: grid;
        place-items: center;
        margin-bottom: 24px;
        border-radius: 15px;
        background: #315efb;
        color: white;
        font-size: 25px;
        font-weight: bold;
    }

    .login-card h1 {
        margin: 0 0 10px;
        color: #14213d;
        font-size: 28px;
    }

    .login-description {
        margin: 0 0 28px;
        color: #687386;
        line-height: 1.6;
    }

    .login-label {
        display: block;
        margin-bottom: 9px;
        color: #26334a;
        font-size: 14px;
        font-weight: 600;
    }

    .password-box {
        display: flex;
        align-items: center;
        border: 1px solid #d9dfeb;
        border-radius: 10px;
        overflow: hidden;
    }

    .password-box:focus-within {
        border-color: #315efb;
        box-shadow: 0 0 0 3px rgba(49, 94, 251, 0.12);
    }

    .password-box input {
        width: 100%;
        min-width: 0;
        padding: 14px;
        border: none;
        outline: none;
        font-size: 15px;
    }

    .show-password {
        padding: 12px;
        border: none;
        background: white;
        color: #315efb;
        cursor: pointer;
        font-weight: 600;
    }

    .login-button {
        width: 100%;
        margin-top: 22px;
        padding: 15px;
        border: none;
        border-radius: 10px;
        background: #315efb;
        color: white;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
        transition: background 0.2s;
    }

    .login-button:hover {
        background: #2448ce;
    }

    .login-error {
        margin-top: 16px;
        color: #c62828;
        font-size: 14px;
    }

    .login-footer {
        margin-top: 26px;
        color: #8791a2;
        text-align: center;
        font-size: 12px;
    }

    @@media (max-width: 480px) {
        .login-card {
            padding: 28px 22px;
        }
    }
</style>

<div class="login-page">
    <main class="login-card">
        <div class="login-logo">MD</div>

    <h1>Welcome back</h1>
    <p class="login-description">
        Sign in to access your portfolio dashboard.
    </p>

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />

        <label class="login-label" for="Password">
            Admin password
        </label>

        <div class="password-box">
            <input asp-for="Password"
                   id="Password"
                   type="password"
                   placeholder="Enter your password"
                   autocomplete="current-password"
                   required />

            <button class="show-password"
                    type="button"
                    onclick="togglePassword()">
                Show
            </button>
        </div>

        <div asp-validation-summary="ModelOnly"
             class="login-error"></div>

        <button class="login-button" type="submit">
            Sign in to dashboard
        </button>
    </form>

    <div class="login-footer">
        Portfolio Management · Authorized Access
    </div>
</main>
</div>

<script>
    function togglePassword() {
        const password = document.getElementById("Password");
        const button = document.querySelector(".show-password");

        if (password.type === "password") {
            password.type = "text";
            button.textContent = "Hide";
        } else {
            password.type = "password";
            button.textContent = "Show";
        }
    }
</script>