@page
@model MyPortfolioASP.Areas.Admin.Pages.Projects.IndexModel
<link rel="stylesheet" href="~/admin.css" asp-append-version="true" />

<div class="admin-dashboard">
    <aside class="admin-sidebar">
        <h2>MD Admin</h2>
        <p class="sidebar-label">WORKSPACE</p>

    <a class="sidebar-link" href="/Admin">Dashboard</a>
    <a class="sidebar-link active" href="/Admin/Projects">Manage Projects</a>
    <a class="sidebar-link" href="/Admin/Projects/Create">Add New Project</a>

    <p class="sidebar-label">WEBSITE</p>
    <a class="sidebar-link" href="/" target="_blank">View Portfolio</a>
    <a class="sidebar-link" href="/StudentStudyPlanner" target="_blank">View Case Study</a>
</aside>

<main class="admin-main">
    <header class="admin-topbar">
        <div>
            <p class="admin-eyebrow">CONTENT MANAGEMENT SYSTEM</p>
            <h1>Manage Projects</h1>
            <p>Review, edit, publish, and remove portfolio projects.</p>
        </div>

        <a class="admin-primary" href="/Admin/Projects/Create">+ Add Project</a>
    </header>

    <section class="project-summary">
        <div>
            <span>Total Projects</span>
            <strong>@Model.Projects.Count()</strong>
        </div>
        <div>
            <span>Published</span>
            <strong>@Model.Projects.Count(p => p.Status == "Published")</strong>
        </div>
        <div>
            <span>Drafts</span>
            <strong>@Model.Projects.Count(p => p.Status == "Draft")</strong>
        </div>
    </section>

    <div class="projects-heading">
        <div>
            <h2>Your Projects</h2>
            <p>Manage the work displayed on your portfolio.</p>
        </div>
    </div>

    <section class="project-list">
        @foreach (var project in Model.Projects)
        {
            <article class="project-card">
                <div class="project-card-top">
                    <div class="project-number">PROJECT #@project.Id</div>
                    <span class="project-status @(project.Status == "Published" ? "status-published" : "status-draft")">
                        @project.Status
                    </span>
                </div>

                <h3>@project.Name</h3>
                <p class="project-description">@project.Description</p>

                <div class="project-technologies">
                    <span>TECHNOLOGIES</span>
                    <p>@project.Technologies</p>
                </div>

                <div class="project-card-actions">
                    <a class="project-edit-button" href="/Admin/Projects/Edit?id=@project.Id">
                        Edit Project
                    </a>

                    <form method="post" asp-page-handler="Delete"
                          onsubmit="return confirm('Are you sure you want to delete this project?');">
                        <input type="hidden" name="id" value="@project.Id" />
                        <button class="project-delete-button" type="submit">Delete</button>
                    </form>
                </div>
            </article>
        }
    </section>
</main>
</div>